{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yank",
  "version": "0.7.51",
  "identifier": "com.getyank.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "library",
        "title": "Yank",
        "width": 1080,
        "height": 720,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      },
      {
        "label": "palette",
        "title": "Yank Palette",
        "url": "index.html?window=palette",
        "width": 720,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false,
        "windowEffects": {
          "effects": [
            "hudWindow",
            "acrylic"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.openai.com https://api.anthropic.com https://*.anthropic.com http://localhost:* https://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTc0N0I3Mzg4OTUzMzYKUldRMlU0azR0MGVuUTF5YlU2bWVPZTAwRkkrNms1N1M0NGQ1cDBIb28rMitweURNamtnZlFuOUoK",
      "endpoints": [
        "https://github.com/piyushpradhan/yank/releases/latest/download/latest.json"
      ]
    }
  }
}
