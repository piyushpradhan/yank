---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/400-italic.css';
import '@fontsource/inter/500-italic.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@fontsource/caveat/500.css';
import "ember-design-system/tokens.css";
import "../styles/global.css";

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC ?? "https://cloud.umami.is/script.js";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Yank — Clipboard Manager with Natural-Language Search · Mac, Windows, Linux",
  description = "Yank is a free, open-source, local-first clipboard manager with semantic + fuzzy search. Find any clip — text, code, images, colors, links — by describing it in plain English. Available for macOS, Windows, and Linux.",
  ogImage = "/favicon.png",
} = Astro.props;

const canonical = "https://tryyank.com";
const ogImageUrl = `${canonical}${ogImage}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('yank-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="clipboard manager, clipboard history, semantic search, natural language search, AI clipboard, fuzzy search, copy paste manager, local-first, open source, privacy-focused, productivity tool, macOS clipboard, Windows clipboard, Linux clipboard, Raycast alternative, Maccy alternative, Paste alternative, Tauri app, Yank" />
    <meta name="author" content="Piyush Pradhan" />
    <meta name="publisher" content="Piyush Pradhan" />
    <meta name="application-name" content="Yank" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="language" content="English" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Yank releases" href="https://github.com/piyushpradhan/yank/releases.atom" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Yank" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Yank — clipboard manager with natural-language search" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@piyushpradhan" />
    <meta name="twitter:creator" content="@piyushpradhan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Yank — clipboard manager with natural-language search" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preconnect for download CTAs -->
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="preconnect" href="https://github.com" crossorigin />

    <!-- Fonts are bundled via @fontsource (see frontmatter). -->

    {umamiWebsiteId && (
      <script defer src={umamiSrc} data-website-id={umamiWebsiteId}></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
