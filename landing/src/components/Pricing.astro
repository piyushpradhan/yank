---
const plans = [
  {
    name: "Local",
    price: "$0",
    per: "/ forever",
    featured: false,
    blurb:
      "Everything that runs on your machine. MIT-licensed, no account, no strings.",
    items: [
      "Unlimited local clipboard history",
      "On-device entity classifier",
      "Natural-language search (local model)",
      "All formats: text, images, files, code",
      "Global hotkey, source tracking",
    ],
    cta: { label: "Download free", href: "#top", primary: false },
  },
  {
    name: "Pro",
    price: "$4",
    per: "/ month",
    featured: true,
    blurb:
      "Encrypted sync across your devices, plus the larger NL model for fuzzier asks.",
    items: [
      "Everything in Local",
      "End-to-end encrypted sync",
      "Cross-device recall",
      "Larger language model for fuzzy phrasing",
      "Smart redaction (cards, secrets, tokens)",
      "Priority email support",
    ],
    cta: { label: "Start 14-day trial", href: "#top", primary: true },
  },
  {
    name: "Team",
    price: "$9",
    per: "/ seat / month",
    featured: false,
    blurb:
      "Shared snippet libraries with per-team redaction and audit. SSO available.",
    items: [
      "Everything in Pro",
      "Shared snippet collections",
      "Role-based redaction rules",
      "SSO (SAML, OIDC)",
      "Centralized billing & audit log",
    ],
    muted: ["SOC 2 — in progress"],
    cta: {
      label: "Talk to us",
      href: "mailto:hi@yankapp.io",
      primary: false,
    },
  },
];
---

<section class="section" id="pricing" data-screen-label="pricing">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Pricing</span>
        <h2>Free to use. Pay if it earns it.</h2>
      </div>
      <p>
        The local app is open-source and free, forever. Pro is for people who
        want sync, cloud recall, and the natural-language model that scales
        beyond a single machine.
      </p>
    </div>

    <div class="plans">
      {
        plans.map((plan) => (
          <article class={`plan${plan.featured ? " plan--featured" : ""}`}>
            <span class="name">{plan.name}</span>
            <div class="price">
              {plan.price} <span class="per">{plan.per}</span>
            </div>
            <p class="blurb">{plan.blurb}</p>
            <ul>
              {plan.items.map((item) => (
                <li>{item}</li>
              ))}
              {plan.muted?.map((item) => (
                <li class="muted">{item}</li>
              ))}
            </ul>
            <a
              class={`btn btn--lg ${plan.cta.primary ? "btn--primary" : "btn--secondary"}`}
              href={plan.cta.href}
            >
              {plan.cta.label}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
