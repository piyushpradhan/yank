---
const shots = [
  {
    src: "/media/palette-image-preview.png",
    title: "Quick palette",
    body: "Global hotkey opens a Spotlight-style palette over any app. Arrow keys, type-to-filter, Enter to paste.",
    width: 1440,
    height: 900,
  },
  {
    src: "/media/library-image-filter.png",
    title: "Full library",
    body: "Browse, filter, edit labels, and pin clips. Time grouping, category sidebar, and a preview pane on the side.",
    width: 1440,
    height: 900,
  },
];
---

<section
  class="border-t border-border-subtle py-20 max-[880px]:py-14"
  id="showcase"
>
  <div class="mx-auto max-w-[1120px] px-6 max-[720px]:px-[18px]">
    <div class="mb-12 max-w-[620px]">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">
        A look around
      </span>
      <h2 class="mt-2.5 text-[clamp(30px,4vw,42px)] leading-[1.1]">
        Two surfaces. One mental model.
      </h2>
      <p class="mt-3 text-base leading-[1.55] text-fg-muted">
        Reach for the palette mid-flow. Open the library when you want to
        organize, label, and dig.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-6 max-[880px]:grid-cols-1">
      {
        shots.map((s) => (
          <figure class="m-0">
            <div
              class="overflow-hidden rounded-xl border border-border bg-surface transition-all duration-[250ms] hover:-translate-y-1"
              style="box-shadow: 0 30px 80px -30px rgba(0,0,0,0.6), 0 10px 30px -10px rgba(0,0,0,0.3);"
            >
              <img
                src={s.src}
                alt={s.title}
                width={s.width}
                height={s.height}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>
            <figcaption>
              <h3 class="mt-[18px] mb-1 text-base">{s.title}</h3>
              <p class="text-[13.5px] leading-[1.5] text-fg-muted">{s.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
