---
import { getLatestRelease } from "../lib/releases";

const { release, downloads } = await getLatestRelease();
const fallbackUrl =
  release?.html_url ?? "https://github.com/piyushpradhan/yank/releases/latest";

const macDownload = downloads.macos?.url ?? fallbackUrl;
const macSize = downloads.macos?.label?.split(" · ")[0] ?? "";
const winDownload = downloads.windows?.url ?? fallbackUrl;
const winSize = downloads.windows?.label?.split(" · ")[0] ?? "";
const linuxDownload = downloads.linux?.url ?? fallbackUrl;
const linuxSize = downloads.linux?.label?.split(" · ")[0] ?? "";

const BREW_CMD = "brew install --cask piyushpradhan/yank/yank";
---

<section class="section install-section" id="install" data-screen-label="install">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">Install</span>
        <h2>One command per platform. No drag-and-drop dance.</h2>
      </div>
      <p>
        On macOS we ship through Homebrew so the app launches the first
        time without Gatekeeper warnings. Windows and Linux are direct
        downloads — both verified by the updater's signing key.
      </p>
    </div>

    <div class="installs">
      <article
        class="install install--mac"
        data-os="mac"
        aria-labelledby="install-mac-heading"
      >
        <header class="install__head">
          <span class="install__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16.5 2c.2 1.2-.3 2.5-1.1 3.4-.8.9-2.1 1.5-3.3 1.4-.2-1.2.4-2.4 1.2-3.3.8-1 2-1.5 3.2-1.5Z"/>
              <path d="M20.5 17.2c-.6 1.3-.9 1.9-1.7 3.1-1.1 1.6-2.6 3.7-4.5 3.7-1.7 0-2.1-1.1-4.4-1.1-2.3 0-2.8 1.1-4.5 1.1-1.9 0-3.4-1.9-4.4-3.5C-.5 16.6-.8 11.4 1 8.6 2.4 6.7 4.5 5.5 6.5 5.5c2 0 3.2 1.1 4.8 1.1 1.5 0 2.5-1.1 4.8-1.1 1.8 0 3.7 1 5 2.7-4.4 2.4-3.7 8.7-.6 9Z"/>
            </svg>
          </span>
          <div>
            <h3 id="install-mac-heading">macOS</h3>
            <span class="install__arch">Apple Silicon · Big Sur+</span>
          </div>
          <span class="install__badge" aria-label="Recommended">Recommended</span>
        </header>

        <p class="install__lede">
          Copy the command, paste it into Terminal. Yank lives in
          <code>/Applications</code> and updates with <code>brew upgrade</code>.
        </p>

        <button
          type="button"
          class="cmd"
          data-copy={BREW_CMD}
          data-track="brew"
          aria-label="Copy Homebrew install command"
        >
          <span class="cmd__prompt" aria-hidden="true">$</span>
          <span class="cmd__text">{BREW_CMD}</span>
          <span class="cmd__action">
            <svg class="cmd__copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="1.5"/>
              <path d="M4 15V5a1 1 0 0 1 1-1h10"/>
            </svg>
            <svg class="cmd__check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l5 5L20 7"/>
            </svg>
            <span class="cmd__label" aria-live="polite"></span>
          </span>
        </button>

        <p class="install__note">
          Apple Silicon only · Intel Mac build coming soon — for now,
          <a href="https://github.com/piyushpradhan/yank#building-from-source">build from source</a>.
        </p>

        <details class="install__alt">
          <summary>Prefer a direct download?</summary>
          <p>
            Grab the <a href={macDownload} data-track="mac-dmg">
              <code>.dmg</code>{macSize ? ` (${macSize})` : ""}</a>, then run
            this once before opening so macOS doesn't claim it's "damaged":
          </p>
          <button
            type="button"
            class="cmd cmd--alt"
            data-copy="xattr -dr com.apple.quarantine /Applications/Yank.app"
            data-track="quarantine"
            aria-label="Copy xattr quarantine command"
          >
            <span class="cmd__prompt" aria-hidden="true">$</span>
            <span class="cmd__text">xattr -dr com.apple.quarantine /Applications/Yank.app</span>
            <span class="cmd__action">
              <svg class="cmd__copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="1.5"/>
                <path d="M4 15V5a1 1 0 0 1 1-1h10"/>
              </svg>
              <svg class="cmd__check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l5 5L20 7"/>
              </svg>
              <span class="cmd__label" aria-live="polite"></span>
            </span>
          </button>
        </details>
      </article>

      <article
        class="install"
        data-os="win"
        aria-labelledby="install-win-heading"
      >
        <header class="install__head">
          <span class="install__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="8" height="8" rx="0.6"/>
              <rect x="13" y="3" width="8" height="8" rx="0.6"/>
              <rect x="3" y="13" width="8" height="8" rx="0.6"/>
              <rect x="13" y="13" width="8" height="8" rx="0.6"/>
            </svg>
          </span>
          <div>
            <h3 id="install-win-heading">Windows</h3>
            <span class="install__arch">x64 · Windows 10+</span>
          </div>
        </header>

        <p class="install__lede">
          Download the installer and double-click. Yank auto-updates from
          the in-app menu — no reinstall needed.
        </p>

        <a class="install__primary btn btn--secondary btn--lg" href={winDownload} data-track="win-exe">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v12M6 10l6 6 6-6M4 20h16"/>
          </svg>
          <span>Download <code>.exe</code>{winSize ? ` · ${winSize}` : ""}</span>
        </a>

        <p class="install__note">
          NSIS installer · signed by the Yank updater key.
        </p>
      </article>

      <article
        class="install"
        data-os="linux"
        aria-labelledby="install-linux-heading"
      >
        <header class="install__head">
          <span class="install__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="1.6"/>
              <path d="M7 10l3 3-3 3M13 16h4"/>
            </svg>
          </span>
          <div>
            <h3 id="install-linux-heading">Linux</h3>
            <span class="install__arch">x86_64 · AppImage or .deb</span>
          </div>
        </header>

        <p class="install__lede">
          Download the AppImage, make it executable, run it. Or grab the
          <code>.deb</code> if you prefer apt.
        </p>

        <a class="install__primary btn btn--secondary btn--lg" href={linuxDownload} data-track="linux-appimage">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v12M6 10l6 6 6-6M4 20h16"/>
          </svg>
          <span>Download <code>.AppImage</code>{linuxSize ? ` · ${linuxSize}` : ""}</span>
        </a>

        <button
          type="button"
          class="cmd cmd--alt"
          data-copy="chmod +x Yank-*.AppImage && ./Yank-*.AppImage"
          data-track="appimage-chmod"
          aria-label="Copy AppImage run command"
        >
          <span class="cmd__prompt" aria-hidden="true">$</span>
          <span class="cmd__text">chmod +x Yank-*.AppImage && ./Yank-*.AppImage</span>
          <span class="cmd__action">
            <svg class="cmd__copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="1.5"/>
              <path d="M4 15V5a1 1 0 0 1 1-1h10"/>
            </svg>
            <svg class="cmd__check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l5 5L20 7"/>
            </svg>
            <span class="cmd__label" aria-live="polite"></span>
          </span>
        </button>
      </article>
    </div>
  </div>
</section>

<style>
  .installs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--s-8);
  }
  @media (max-width: 960px) {
    .installs { grid-template-columns: 1fr; }
  }

  .install {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--r-lg);
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .install--mac {
    border-color: color-mix(in oklab, var(--accent-500) 35%, var(--border-default));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent-500) 18%, transparent),
      var(--shadow-sm);
  }

  .install__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
  }
  .install__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--r-sm);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .install--mac .install__icon {
    background: color-mix(in oklab, var(--accent-500) 12%, var(--bg-subtle));
    color: var(--accent-600);
  }
  [data-theme='dark'] .install--mac .install__icon {
    color: var(--accent-500);
  }
  .install__head h3 {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    letter-spacing: -0.015em;
    font-weight: 500;
    line-height: 1.1;
  }
  .install__arch {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
  .install__badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: color-mix(in oklab, var(--accent-500) 14%, transparent);
    color: var(--accent-600);
    white-space: nowrap;
  }
  [data-theme='dark'] .install__badge {
    color: var(--accent-500);
  }

  .install__lede {
    font-family: var(--font-serif);
    font-size: var(--t-base);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .install__lede code,
  .install__alt code,
  .install__primary code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--text-primary);
  }

  /* Command block — tap to copy */
  .cmd {
    appearance: none;
    background: var(--bg-canvas);
    border: 1px solid var(--border-default);
    border-radius: var(--r-md);
    padding: var(--s-3) var(--s-4);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--text-primary);
    transition:
      border-color 120ms,
      background 120ms;
  }
  .cmd:hover {
    border-color: var(--border-strong);
    background: var(--bg-subtle);
  }
  .cmd--alt {
    background: var(--bg-subtle);
    padding: var(--s-2) var(--s-3);
    font-size: var(--t-xs);
  }
  .cmd__prompt {
    color: var(--accent-500);
    font-weight: 500;
  }
  .cmd__text {
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .cmd__text::-webkit-scrollbar { display: none; }
  .cmd__action {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-tertiary);
    font-size: var(--t-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 120ms;
  }
  .cmd:hover .cmd__action { color: var(--text-secondary); }
  .cmd__check { display: none; }
  .cmd.is-copied .cmd__copy { display: none; }
  .cmd.is-copied .cmd__check { display: inline-block; color: var(--accent-500); }
  .cmd.is-copied .cmd__action { color: var(--accent-500); }
  .cmd__label::after { content: 'Copy'; }
  .cmd.is-copied .cmd__label::after { content: 'Copied'; }

  .install__primary {
    width: 100%;
  }
  .install__primary code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 1em;
  }
  .install__note {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }
  .install__note a {
    color: var(--accent-600);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in oklab, var(--accent-500) 40%, transparent);
  }
  [data-theme='dark'] .install__note a { color: var(--accent-500); }
  .install__note a:hover { text-decoration-color: currentColor; }

  .install__alt {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px dashed var(--border-subtle);
  }
  .install__alt summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    transition: color 120ms;
  }
  .install__alt summary:hover { color: var(--text-secondary); }
  .install__alt summary::-webkit-details-marker { display: none; }
  .install__alt summary::before {
    content: '+';
    color: var(--accent-500);
    font-family: var(--font-mono);
    transition: transform 200ms;
  }
  .install__alt[open] summary::before {
    content: '−';
  }
  .install__alt p {
    font-family: var(--font-serif);
    font-size: var(--t-sm);
    color: var(--text-secondary);
    line-height: 1.55;
    margin: var(--s-3) 0;
  }
  .install__alt a {
    color: var(--accent-600);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in oklab, var(--accent-500) 40%, transparent);
  }
  [data-theme='dark'] .install__alt a {
    color: var(--accent-500);
  }
  .install__alt a:hover {
    text-decoration-color: currentColor;
  }
</style>

<script>
  function track(name: string, data?: Record<string, unknown>) {
    (window as any).umami?.track?.(name, data);
  }

  document.querySelectorAll<HTMLButtonElement>('.install-section .cmd').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      const tag = btn.getAttribute('data-track') || '';
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('is-copied');
        track('install_copy', { command: tag });
        window.setTimeout(() => btn.classList.remove('is-copied'), 1800);
      } catch (_) {
        // Clipboard API blocked — fall back to a selection so users can ⌘C.
        const range = document.createRange();
        const node = btn.querySelector('.cmd__text');
        if (node) {
          range.selectNodeContents(node);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.install-section a[data-track]').forEach((a) => {
    a.addEventListener('click', () => {
      track('install_download', { target: a.getAttribute('data-track') });
    });
  });
</script>
