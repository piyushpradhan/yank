---
import { getLatestRelease } from "../lib/releases";
import rootPkg from "../../../package.json";

const { release, downloads } = await getLatestRelease();
const fallbackUrl =
  release?.html_url ?? "https://github.com/piyushpradhan/yank/releases/latest";

const downloadMap = {
  mac: downloads.macos?.url ?? fallbackUrl,
  win: downloads.windows?.url ?? fallbackUrl,
  linux: downloads.linux?.url ?? fallbackUrl,
};

const version = release?.version ?? `v${rootPkg.version}`;
const versionLabel = version.startsWith("v") ? version : `v${version}`;

const sizeLabel =
  downloads.macos?.label?.split(" · ")[0] ??
  downloads.windows?.label?.split(" · ")[0] ??
  downloads.linux?.label?.split(" · ")[0] ??
  "14 MB";
---

<section
  class="hero"
  id="top"
  data-screen-label="hero"
  aria-labelledby="hero-heading"
  data-downloads={JSON.stringify(downloadMap)}
>
  <div class="wrap grid">
    <div class="hero-copy">
      <span class="eyebrow">Clipboard · with language</span>
      <h1 id="hero-heading">Your clipboard,<br /><em>in your words.</em></h1>
      <p class="lede">
        The clipboard manager with natural-language search. Describe what you
        copied and Yank pastes back exactly that — nothing else.
      </p>

      <ul class="hero-queries" aria-label="Searches Yank understands">
        <li>the phone number from earlier</li>
        <li>that repo from Tuesday</li>
        <li>the hex value from Figma</li>
      </ul>

      <div class="ctas">
        <a class="btn btn--primary btn--lg" id="cta-download" href="#install">
          <span class="os-icon" id="cta-download-os-icon" aria-hidden="true"></span>
          <span id="cta-download-label">Install Yank</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 4v12M6 10l6 6 6-6M4 20h16" />
          </svg>
        </a>
        <a
          class="btn btn--secondary btn--lg"
          href="https://github.com/piyushpradhan/yank"
          target="_blank"
          rel="noopener noreferrer"
          data-track-github="repo"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.69-.01-1.36-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>View source</span>
        </a>
      </div>

      <div class="hero-trust">
        <div class="meta">
          <span>{versionLabel}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{sizeLabel}</span>
          <span class="dot" aria-hidden="true"></span>
          <span class="hero-platforms">
            <a href={downloadMap.mac} data-os="mac">macOS</a>
            <a href={downloadMap.win} data-os="win">Windows</a>
            <a href={downloadMap.linux} data-os="linux">Linux</a>
          </span>
        </div>
        <a
          class="ph-badge"
          href="https://www.producthunt.com/products/yank-2?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-yank-4"
          target="_blank"
          rel="noopener noreferrer"
          data-track-github="producthunt"
          ><img
            alt="Yank - A clipboard that understands intent, not just bytes. | Product Hunt"
            width="220"
            height="47"
            src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1180172&theme=light&t=1782413356149"
          /></a
        >
      </div>
    </div>

    <div class="hero-visual">
      <span class="hero-glow" aria-hidden="true"></span>
      <aside class="app" aria-label="Yank app preview">
      <div class="app__chrome">
        <div class="lights"><span></span><span></span><span></span></div>
        <span class="title">yank ⌁ history</span>
      </div>

      <div class="app__query">
        <span class="prompt">›</span>
        <span class="typed" id="typed-query"></span><span class="caret" aria-hidden="true"></span>
      </div>

      <ul class="app__list" id="result-list">
        <li aria-selected="true">
          <span class="kind kind--repo">repo</span>
          <span class="body"><em>github.com/piyushpradhan/yank</em></span>
          <span class="meta-cell">2d ago · Arc</span>
        </li>
        <li>
          <span class="kind kind--repo">repo</span>
          <span class="body">github.com/piyushpradhan/ember-design-system</span>
          <span class="meta-cell">3d ago · Arc</span>
        </li>
        <li>
          <span class="kind kind--phone">phone</span>
          <span class="body">+1 (415) 555&#8209;0136</span>
          <span class="meta-cell">5d ago · Messages</span>
        </li>
        <li>
          <span class="kind kind--date">date</span>
          <span class="body">Tue, May 28, 2026 · 11:30 PT</span>
          <span class="meta-cell">5d ago · Cal</span>
        </li>
        <li>
          <span class="kind kind--color">color</span>
          <span class="body"
            ><span class="swatch" style="background:#D9541A"></span>#D9541A · ember-500</span
          >
          <span class="meta-cell">1w ago · Figma</span>
        </li>
        <li>
          <span class="kind kind--url">url</span>
          <span class="body">linear.app/yank/issue/YNK-241</span>
          <span class="meta-cell">1w ago · Linear</span>
        </li>
        <li>
          <span class="kind kind--email">email</span>
          <span class="body">hi@yankapp.io</span>
          <span class="meta-cell">2w ago · Mail</span>
        </li>
      </ul>

      <div class="app__statusbar">
        <span>4,217 items · indexed locally</span>
        <span class="keys">
          <span><b>↑↓</b> navigate</span>
          <span><b>↵</b> paste</span>
          <span><b>⌘K</b> ask</span>
        </span>
      </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ctas {
    align-items: center;
  }
  .ph-badge {
    display: inline-flex;
  }
  .ph-badge img {
    display: block;
  }
</style>

<script>
  function track(name: string, data?: Record<string, unknown>) {
    (window as any).umami?.track?.(name, data);
  }
  (function () {
    var hero = document.querySelector('.hero');
    var raw = hero ? hero.getAttribute('data-downloads') : null;
    var downloads = { mac: '#', win: '#', linux: '#' };
    try {
      if (raw) downloads = JSON.parse(raw);
    } catch (_) {}

    var ua = navigator.userAgent + ' ' + (navigator.platform || '');
    var isMobile = /Android|iPhone|iPad|iPod|webOS|BlackBerry|Opera Mini|IEMobile|Mobile/i.test(ua);
    var os = 'mac';
    var osLabel = 'macOS';
    if (/Win(dows)?/i.test(ua)) {
      os = 'win';
      osLabel = 'Windows';
    } else if (/Linux|X11/i.test(ua) && !/Android/i.test(ua)) {
      os = 'linux';
      osLabel = 'Linux';
    }

    document.body.dataset.os = os;

    var navLabel = document.getElementById('download-label');
    var ctaLabel = document.getElementById('cta-download-label');
    if (navLabel) navLabel.textContent = os === 'mac' ? 'Install' : 'Download';
    if (ctaLabel) {
      if (isMobile) {
        ctaLabel.textContent = os === 'mac' ? 'Install' : 'Download';
      } else if (os === 'mac') {
        ctaLabel.textContent = 'Install for macOS';
      } else {
        ctaLabel.textContent = 'Download for ' + osLabel;
      }
    }

    // macOS users go through the Install section (Homebrew + quarantine note);
    // Windows/Linux still get the direct binary URL.
    var url = downloads[os] || downloads.mac;
    var navCta = document.getElementById('download-cta');
    var heroCta = document.getElementById('cta-download');
    var navUrl = os === 'mac' ? '#install' : url;
    var heroUrl = os === 'mac' ? '#install' : url;
    if (navCta) navCta.setAttribute('href', navUrl);
    if (heroCta) heroCta.setAttribute('href', heroUrl);

    var OS_ICONS = {
      mac:
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%">' +
        '<rect x="3" y="4" width="18" height="12" rx="1.2"/><path d="M2 20h20"/></svg>',
      win:
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%">' +
        '<rect x="3" y="3" width="8" height="8" rx="0.6"/><rect x="13" y="3" width="8" height="8" rx="0.6"/>' +
        '<rect x="3" y="13" width="8" height="8" rx="0.6"/><rect x="13" y="13" width="8" height="8" rx="0.6"/></svg>',
      linux:
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%">' +
        '<rect x="3" y="4" width="18" height="16" rx="1.2"/><path d="M7 10l3 3-3 3M13 16h4"/></svg>',
    };
    var icon = OS_ICONS[os];
    var navIcon = document.getElementById('download-os-icon');
    var heroIcon = document.getElementById('cta-download-os-icon');
    if (navIcon) navIcon.innerHTML = icon;
    if (heroIcon) heroIcon.innerHTML = icon;

    if (heroCta) {
      heroCta.addEventListener('click', function () {
        track('download_click', { platform: osLabel, location: 'hero_cta' });
      });
    }

    var PLATFORM_LABEL = { mac: 'macOS', win: 'Windows', linux: 'Linux' };
    var platformLinks = document.querySelectorAll('.hero-platforms a');
    platformLinks.forEach(function (a) {
      if (a instanceof HTMLElement) {
        if (a.dataset.os === os) {
          a.setAttribute('aria-current', 'true');
        }
        a.addEventListener('click', function () {
          var p = PLATFORM_LABEL[a.dataset.os] || a.dataset.os;
          track('download_click', { platform: p, location: 'hero_platforms' });
        });
      }
    });

    // Mobile: show subtle desktop-only note below the CTAs
    if (isMobile) {
      var ctasDiv = document.querySelector('.hero .ctas');
      if (ctasDiv) {
        var note = document.createElement('p');
        note.className = 'mobile-note';
        note.textContent = 'Desktop only  ·  macOS, Windows & Linux';
        note.style.cssText = 'margin-top:var(--s-4);font-size:var(--t-xs);color:var(--text-tertiary);font-style:italic;';
        ctasDiv.insertAdjacentElement('afterend', note);
      }
    }

    // Typing demo for the app preview query line.
    var el = document.getElementById('typed-query');
    if (el) {
      var queries = [
        'the github repo from yesterday',
        'the hex value from Figma',
        'the long phone number',
      ];
      var qi = 0;
      var ci = 0;
      var dir = 1;
      var hold = 0;
      el.textContent = '';
      setInterval(function () {
        var q = queries[qi];
        if (dir === 1) {
          ci++;
          el.textContent = q.slice(0, ci);
          if (ci >= q.length) {
            dir = 0;
            hold = 50;
          }
        } else if (dir === 0) {
          hold--;
          if (hold <= 0) dir = -1;
        } else {
          ci--;
          el.textContent = q.slice(0, ci);
          if (ci <= 0) {
            dir = 1;
            qi = (qi + 1) % queries.length;
          }
        }
      }, 55);
    }
  })();
</script>
