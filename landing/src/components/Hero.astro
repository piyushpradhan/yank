---
import { Icon } from "astro-icon/components";
---

<section class="relative overflow-hidden py-20 pb-[100px] max-[980px]:py-14 max-[980px]:pb-16">
  <div class="mx-auto grid max-w-[1120px] grid-cols-[minmax(320px,1fr)_minmax(320px,1.15fr)] items-center gap-[60px] px-6 max-[980px]:grid-cols-1 max-[980px]:gap-10 max-[720px]:px-[18px]">
    <div class="flex flex-col gap-[22px]">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">v0.6 — local first</span>
      <h1 class="mt-1.5 text-[clamp(40px,6vw,64px)] leading-[1.04]">
        A clipboard that<br />
        <span class="bg-gradient-to-br from-accent to-accent-ink bg-clip-text text-transparent">
          remembers everything.
        </span>
      </h1>
      <p class="max-w-[540px] text-[17px] leading-[1.55] text-fg-muted max-[980px]:max-w-none">
        Yank is a fast, private clipboard manager for macOS, Windows, and
        Linux. Fuzzy search. Semantic search. Images, code, links, colors —
        every clip you've ever made, one keystroke away.
      </p>
      <div class="mt-1.5 flex flex-wrap gap-3">
        <a
          class="inline-flex h-10 items-center gap-2 rounded-md border border-transparent bg-accent px-4 text-sm font-medium tracking-[-0.01em] text-fg-inverse shadow-ember-sm transition-all duration-150 hover:-translate-y-px hover:bg-accent-strong hover:shadow-ember-md"
          href="#download"
        >
          Download
          <Icon name="lucide:download" width={14} height={14} aria-hidden="true" />
        </a>
        <a
          class="inline-flex h-10 items-center gap-2 rounded-md border border-border bg-transparent px-4 text-sm font-medium tracking-[-0.01em] text-fg transition-all duration-150 hover:-translate-y-px hover:border-accent hover:text-accent-strong"
          href="https://github.com/piyushpradhan/recall"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
          <Icon name="lucide:arrow-up-right" width={14} height={14} aria-hidden="true" />
        </a>
      </div>
      <div class="mt-2 flex items-center gap-1.5 text-[12.5px] text-fg-faint">
        <span>Press</span>
        <span class="kbd-chip">Ctrl</span>
        <span class="kbd-chip">Shift</span>
        <span class="kbd-chip">V</span>
        <span>to open the palette anywhere.</span>
      </div>
    </div>

    <div class="relative">
      <div
        class="relative z-[2] overflow-hidden rounded-xl border border-border bg-surface"
        style="box-shadow: 0 60px 120px -30px rgba(0,0,0,0.7), 0 20px 40px -10px rgba(0,0,0,0.4);"
      >
        <div class="relative flex items-center gap-2 border-b border-border-subtle bg-subtle px-3.5 py-2.5">
          <span class="h-[11px] w-[11px] rounded-full bg-danger"></span>
          <span class="h-[11px] w-[11px] rounded-full bg-warning"></span>
          <span class="h-[11px] w-[11px] rounded-full bg-success"></span>
          <span class="absolute left-1/2 -translate-x-1/2 font-mono text-[11px] tracking-[0.05em] text-fg-faint">
            Yank — Quick Palette
          </span>
        </div>
        <video
          src="/media/image-copy-paste.webm"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-label="Yank palette demo: searching for an image clip and pasting it"
          class="block h-auto w-full"
        ></video>
      </div>
      <div
        class="pointer-events-none absolute -inset-10 z-[1] blur-xl"
        style="background: radial-gradient(400px 280px at 50% 50%, color-mix(in oklab, var(--accent-ember-500) 38%, transparent), transparent 70%);"
        aria-hidden="true"
      ></div>
    </div>
  </div>
</section>

<style>
  /* Kbd chip — used here and in Download. Centralised so the styling matches
   * the in-app kbd visual without per-instance class repetition. */
  .kbd-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    background: color-mix(in oklab, var(--text-primary) 6%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    box-shadow: inset 0 -1px 0
      color-mix(in oklab, var(--text-primary) 10%, transparent);
    line-height: 1;
  }
</style>
