---
import { Icon } from "astro-icon/components";
import { getLatestRelease } from "../lib/releases";

const { downloads } = await getLatestRelease();

const platforms = [
  {
    key: "macos",
    name: "macOS",
    icon: "simple-icons:apple",
    downloadUrl: downloads.macos.url,
    meta: downloads.macos.label,
  },
  {
    key: "windows",
    name: "Windows",
    icon: "simple-icons:windows",
    downloadUrl: downloads.windows.url,
    meta: downloads.windows.label,
  },
  {
    key: "linux",
    name: "Linux",
    icon: "simple-icons:linux",
    downloadUrl: downloads.linux.url,
    meta: downloads.linux.label,
  },
];
---

<section
  class="relative border-t border-border-subtle py-20 max-[720px]:py-14"
  id="download"
>
  <div class="mx-auto max-w-[1120px] px-6 max-[720px]:px-[18px]">
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-surface px-12 py-[60px] max-[720px]:px-6 max-[720px]:py-10"
      style="background: radial-gradient(600px 300px at 80% 0%, color-mix(in oklab, var(--accent-ember-500) 28%, transparent), transparent 60%), var(--bg-surface);"
    >
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">
        Get Yank
      </span>
      <h2 class="mt-2.5 max-w-[580px] text-[clamp(30px,4vw,40px)] leading-[1.1]">
        Free, open source, ready to ship.
      </h2>
      <p class="mt-3.5 max-w-[520px] text-base leading-[1.55] text-fg-muted">
        Latest installers are attached to every GitHub release. Pick your
        platform — we've highlighted the right one for your system.
      </p>

      <!-- Smart download cards -->
      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-3">
        {
          platforms.map((p) => (
            <a
              data-platform={p.key}
              class="download-card group flex items-center gap-3.5 rounded-[10px] border border-border-subtle px-5 py-[18px] text-fg no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-muted"
              href={p.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              style="background: color-mix(in oklab, var(--bg-subtle) 80%, transparent);"
            >
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent-ink" aria-hidden="true">
                <Icon name={p.icon} width={22} height={22} />
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="text-sm font-semibold tracking-[-0.01em]">{p.name}</span>
                <span class="font-mono text-[11.5px] text-fg-faint">{p.meta}</span>
              </div>
              <span
                class="download-card__badge hidden shrink-0 items-center gap-1 rounded-md bg-accent px-2 py-0.5 text-[10.5px] font-semibold uppercase tracking-[0.04em] text-fg-inverse"
              >
                For you
              </span>
              <Icon
                name="lucide:arrow-right"
                width={16}
                height={16}
                class="download-card__chevron shrink-0 text-fg-faint transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>

      <p class="mt-7 text-[13px] text-fg-faint">
        Or build from source —
        <a
          href="https://github.com/piyushpradhan/recall#getting-started"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-accent-soft text-accent-ink hover:text-accent transition-colors duration-150"
          >see the README</a
        >.
      </p>
    </div>
  </div>
</section>

<script>
  (function () {
    function detectOS() {
      var ua = navigator.userAgent || ''
      var platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || ''
      if (/windows|win32|win64/i.test(ua) || /win/i.test(platform)) return 'windows'
      if (/macintosh|mac os x|macintel/i.test(ua) || /mac/i.test(platform)) return 'macos'
      if (/linux/i.test(ua) || /linux/i.test(platform)) return 'linux'
      return ''
    }

    var detected = detectOS()
    if (!detected) return

    var card = document.querySelector('[data-platform="' + detected + '"]')
    if (card) {
      card.classList.add('ring-2', 'ring-accent')
      card.style.background = 'color-mix(in oklab, var(--accent-ember-500) 10%, var(--bg-surface))'
      var badge = card.querySelector('.download-card__badge')
      var chevron = card.querySelector('.download-card__chevron')
      if (badge) { badge.classList.remove('hidden'); badge.classList.add('inline-flex') }
      if (chevron) chevron.classList.add('hidden')
    }

    var heroBtn = document.getElementById('hero-download-btn')
    if (heroBtn && card) {
      heroBtn.setAttribute('href', card.getAttribute('href') || '#download')
    }
  })()
</script>
