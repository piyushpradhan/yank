---
import { Icon } from "astro-icon/components";

const releasesUrl = "https://github.com/piyushpradhan/recall/releases/latest";

const platforms = [
  {
    label: "macOS",
    sublabel: "Apple Silicon · .dmg",
    href: `${releasesUrl}`,
    icon: "simple-icons:apple",
  },
  {
    label: "Windows",
    sublabel: "x64 · NSIS installer",
    href: `${releasesUrl}`,
    icon: "simple-icons:windows",
  },
  {
    label: "Linux",
    sublabel: "x64 · AppImage / .deb",
    href: `${releasesUrl}`,
    icon: "simple-icons:linux",
  },
];
---

<section
  class="relative border-t border-border-subtle py-20 max-[720px]:py-14"
  id="download"
>
  <div class="mx-auto max-w-[1120px] px-6 max-[720px]:px-[18px]">
    <div
      class="relative overflow-hidden rounded-2xl border border-border bg-surface px-12 py-[60px] max-[720px]:px-6 max-[720px]:py-10"
      style="background: radial-gradient(600px 300px at 80% 0%, color-mix(in oklab, var(--accent-ember-500) 28%, transparent), transparent 60%), var(--bg-surface);"
    >
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">
        Get Yank
      </span>
      <h2 class="mt-2.5 max-w-[580px] text-[clamp(30px,4vw,40px)] leading-[1.1]">
        Free, open source, ready to ship.
      </h2>
      <p class="mt-3.5 max-w-[520px] text-base leading-[1.55] text-fg-muted">
        Latest installers are attached to every GitHub release. Pick your
        platform — the rest is one click.
      </p>

      <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3">
        {
          platforms.map((p) => (
            <a
              class="platform group flex items-center gap-3.5 rounded-[10px] border border-border-subtle px-5 py-[18px] text-fg transition-all duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-muted"
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              style="background: color-mix(in oklab, var(--bg-subtle) 80%, transparent);"
            >
              <div class="flex h-8 w-8 items-center justify-center text-accent-ink" aria-hidden="true">
                <Icon name={p.icon} width={26} height={26} />
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="text-sm font-semibold tracking-[-0.01em]">{p.label}</span>
                <span class="font-mono text-[11.5px] text-fg-faint">{p.sublabel}</span>
              </div>
              <Icon
                name="lucide:arrow-right"
                width={16}
                height={16}
                class="shrink-0 text-fg-faint transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>

      <p class="mt-7 text-[13px] text-fg-faint">
        Or build from source —
        <a
          href="https://github.com/piyushpradhan/recall#getting-started"
          target="_blank"
          rel="noopener noreferrer"
          class="border-b border-accent-soft text-accent-ink hover:text-accent"
          >see the README
        </a>.
      </p>
    </div>
  </div>
</section>
