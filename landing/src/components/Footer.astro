---
const year = new Date().getFullYear();
---

<footer class="foot" data-screen-label="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="about">
        <a class="brand" href="#top" aria-label="Yank">
          <svg class="mark" viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="foot-ember" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#f58247"/>
                <stop offset="55%" stop-color="#d9541a"/>
                <stop offset="100%" stop-color="#a8390a"/>
              </linearGradient>
            </defs>
            <rect width="1024" height="1024" rx="224" ry="224" fill="url(#foot-ember)"/>
            <g fill="none" stroke="#fff4ec" stroke-width="160" stroke-linecap="round" stroke-linejoin="round">
              <path d="M 280 260 L 512 552"/>
              <path d="M 744 260 L 512 552"/>
              <path d="M 512 552 L 512 780"/>
            </g>
          </svg>
          <span>yank</span>
        </a>
        <p>
          A smart clipboard for people who copy a lot, and resent looking for
          what they copied.
        </p>
        <a
          class="ph-badge"
          href="https://www.producthunt.com/products/yank-2?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-yank-4"
          target="_blank"
          rel="noopener noreferrer"
          data-track-github="producthunt"
          ><img
            alt="Yank - A clipboard that understands intent, not just bytes. | Product Hunt"
            width="250"
            height="54"
            loading="lazy"
            src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1180172&theme=light&t=1782413356149"
          /></a
        >
      </div>

      <div>
        <h5>Product</h5>
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#how">How it works</a></li>
          <li><a href="#pricing">Pricing</a></li>
          <li><a href="#top">Download</a></li>
        </ul>
      </div>

      <div>
        <h5>Project</h5>
        <ul>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank"
              target="_blank"
              rel="noopener noreferrer"
              data-track-github="repo">GitHub</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/releases"
              target="_blank"
              rel="noopener noreferrer"
              data-track-github="releases">Changelog</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/issues"
              target="_blank"
              rel="noopener noreferrer"
              data-track-github="issues">Roadmap</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/issues"
              target="_blank"
              rel="noopener noreferrer"
              data-track-github="issues">Issues</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h5>Elsewhere</h5>
        <ul>
          <li><a href="#">Privacy</a></li>
          <li><a href="#">Security</a></li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              data-track-github="license">License (MIT)</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} · Made in a small room with a lot of coffee.</span>
      <span class="signature" aria-label="hand-drawn signature: p.p.">p.p.</span>
      <span>Built on Ember.</span>
    </div>
  </div>
</footer>

<style>
  .ph-badge {
    display: inline-block;
    margin-top: 1rem;
  }
  .ph-badge img {
    display: block;
  }
</style>

<script>
  function track(name: string, data?: Record<string, unknown>) {
    (window as any).umami?.track?.(name, data);
  }
  document.querySelectorAll('.foot [data-track-github]').forEach(function (a) {
    a.addEventListener('click', function () {
      var target = a instanceof HTMLElement ? a.dataset.trackGithub : undefined;
      track('github_click', { location: 'footer', target: target || 'repo' });
    });
  });
</script>
