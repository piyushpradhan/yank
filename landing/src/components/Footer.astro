---
const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-border-subtle py-10 pb-[60px]">
  <div class="mx-auto flex max-w-[1120px] flex-col items-center gap-[18px] px-6 text-center max-[720px]:px-[18px]">
    <div class="flex items-center gap-2 font-semibold text-fg">
      <img src="/logo.png" alt="Yank logo" width="22" height="22" />
      <span>Yank</span>
    </div>

    <div class="flex flex-wrap justify-center gap-6 text-[13.5px] text-fg-muted">
      <a
        href="https://github.com/piyushpradhan/recall"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-150 hover:text-accent-ink no-underline">GitHub</a
      >
      <a
        href="https://github.com/piyushpradhan/recall/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-150 hover:text-accent-ink no-underline">Releases</a
      >
      <a
        href="https://github.com/piyushpradhan/recall/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-150 hover:text-accent-ink no-underline">Issues</a
      >
      <a
        href="https://github.com/piyushpradhan/recall/blob/main/README.md"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-150 hover:text-accent-ink no-underline">README</a
      >
    </div>

    <p class="font-mono text-[11.5px] tracking-[0.02em] text-fg-faint">
      &copy; {year} Yank &middot; MIT licensed &middot; Built with Tauri
    </p>
  </div>
</footer>
