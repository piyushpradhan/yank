---
const year = new Date().getFullYear();
---

<footer class="foot" data-screen-label="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="about">
        <a class="brand" href="#top" aria-label="Yank">
          <span class="dot" aria-hidden="true"></span>
          <span>yank</span>
        </a>
        <p>
          A smart clipboard for people who copy a lot, and resent looking for
          what they copied.
        </p>
      </div>

      <div>
        <h5>Product</h5>
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#how">How it works</a></li>
          <li><a href="#pricing">Pricing</a></li>
          <li><a href="#top">Download</a></li>
        </ul>
      </div>

      <div>
        <h5>Project</h5>
        <ul>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank"
              target="_blank"
              rel="noopener noreferrer">GitHub</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/releases"
              target="_blank"
              rel="noopener noreferrer">Changelog</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/issues"
              target="_blank"
              rel="noopener noreferrer">Roadmap</a
            >
          </li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/issues"
              target="_blank"
              rel="noopener noreferrer">Issues</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h5>Elsewhere</h5>
        <ul>
          <li><a href="#">Privacy</a></li>
          <li><a href="#">Security</a></li>
          <li>
            <a
              href="https://github.com/piyushpradhan/yank/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer">License (MIT)</a
            >
          </li>
          <li><a href="mailto:hi@yankapp.io">hi@yankapp.io</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} · Made in a small room with a lot of coffee.</span>
      <span class="signature" aria-label="hand-drawn signature: p.p.">p.p.</span>
      <span>Built on Ember.</span>
    </div>
  </div>
</footer>
