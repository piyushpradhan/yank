---
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "lucide:search",
    title: "Fuzzy + semantic search",
    body: "Find anything in your clipboard history by typing a literal phrase or describing what you meant. Yank ranks every clip by both keyword match and semantic meaning using local embeddings — no cloud, no latency, no privacy trade-off.",
  },
  {
    icon: "lucide:image",
    title: "Native image clips",
    body: "Screenshots, copied images, design assets — Yank captures them all, compresses to PNG automatically, and lets you paste back into any application as if it were your most recent copy. Full preview in the library.",
  },
  {
    icon: "lucide:tag",
    title: "Smart auto-labels",
    body: "Optional AI labeling transforms opaque snippets like 'Lorem ipsum dolor sit amet' into readable labels like 'Latin filler text'. Labels are searchable, editable, and computed locally — nothing leaves your machine unless you bring your own API key and opt in.",
  },
  {
    icon: "lucide:layout-grid",
    title: "Categorized automatically",
    body: "URLs, source code, hex colors, file paths, email addresses, phone numbers, physical addresses — Yank detects and sorts each clip on capture. Filter the entire library by category with a single click in the sidebar.",
  },
  {
    icon: "lucide:shield",
    title: "Local-first, private by design",
    body: "Your entire clipboard history lives in a SQLite file on your machine. No telemetry. No accounts. No cloud sync unless you choose to. Bring your own API keys for optional AI features or skip them entirely — Yank works great either way.",
  },
  {
    icon: "lucide:keyboard",
    title: "Keyboard-driven workflow",
    body: "A global hotkey (Ctrl+Shift+V) opens the quick palette as an overlay on top of any app. Arrow keys navigate results, Enter pastes, ⌘P pins, ⌘⌫ deletes. Press Tab to toggle between fuzzy and semantic search modes — your hands never leave the keyboard.",
  },
];
---

<section
  class="border-t border-border-subtle py-20 max-[720px]:py-14"
  id="features"
>
  <div class="mx-auto max-w-[1120px] px-6 max-[720px]:px-[18px]">
    <div class="mb-12 max-w-[620px]">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">
        What's inside
      </span>
      <h2 class="mt-2.5 text-[clamp(30px,4vw,42px)] leading-[1.1]">
        Built for the way you actually copy.
      </h2>
      <p class="mt-3 text-base leading-[1.55] text-fg-muted">
        Six ideas, each polished until the keyboard feels invisible. No
        configuration required — install and start pasting smarter.
      </p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-4">
      {
        features.map((f, i) => (
          <article class="group rounded-xl border border-border-subtle bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/30 hover:bg-muted">
            <div
              class="mb-3.5 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent-soft text-accent-ink"
              aria-hidden="true"
            >
              <Icon name={f.icon} width={18} height={18} />
            </div>
            <h3 class="mb-1.5 text-base font-semibold tracking-[-0.01em]">{f.title}</h3>
            <p class="text-[13.5px] leading-[1.55] text-fg-muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
