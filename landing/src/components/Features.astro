---
import { Icon } from "astro-icon/components";

const features = [
  {
    icon: "lucide:search",
    title: "Fuzzy + semantic search",
    body: "Type a literal phrase or describe what you mean. Yank ranks every clip by both keyword and intent — local embeddings, no cloud round-trip required.",
  },
  {
    icon: "lucide:image",
    title: "Native image clips",
    body: "Screenshots, copied images, designs — Yank captures them, compresses to PNG, and lets you paste back to any app like the most recent copy.",
  },
  {
    icon: "lucide:tag",
    title: "Smart auto-labels",
    body: "Optional AI labels turn 'Lorem ipsum dolor sit amet' into 'Latin filler text'. Labels are searchable and editable — and never sent to the cloud unless you opt in.",
  },
  {
    icon: "lucide:layout-grid",
    title: "Categorized automatically",
    body: "URLs, code, hex colors, paths, emails, phone numbers, addresses — Yank sorts each clip on the way in. Filter the library by category in one click.",
  },
  {
    icon: "lucide:shield",
    title: "Local-first, private",
    body: "Everything sits in a SQLite file on your machine. No telemetry. No accounts. Bring your own key for the optional AI features, or skip them entirely.",
  },
  {
    icon: "lucide:keyboard",
    title: "Keyboard-driven",
    body: "Global hotkey opens the palette over any app. Arrow keys to navigate, Enter to paste, ⌘P to pin, ⌘⌫ to delete. Tab toggles fuzzy / semantic.",
  },
];
---

<section
  class="border-t border-border-subtle py-20 max-[720px]:py-14"
  id="features"
>
  <div class="mx-auto max-w-[1120px] px-6 max-[720px]:px-[18px]">
    <div class="mb-12 max-w-[620px]">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-strong">
        What's inside
      </span>
      <h2 class="mt-2.5 text-[clamp(30px,4vw,42px)] leading-[1.1]">
        Built for the way you actually copy.
      </h2>
      <p class="mt-3 text-base leading-[1.55] text-fg-muted">
        Six core ideas. Each one polished until the keyboard feels invisible.
      </p>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-3.5">
      {
        features.map((f) => (
          <article class="group rounded-xl border border-border-subtle bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/30 hover:bg-muted">
            <div
              class="mb-3.5 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-accent-soft text-accent-ink"
              aria-hidden="true"
            >
              <Icon name={f.icon} width={18} height={18} />
            </div>
            <h3 class="mb-1.5 text-base tracking-[-0.01em]">{f.title}</h3>
            <p class="text-[13.5px] leading-[1.55] text-fg-muted">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
